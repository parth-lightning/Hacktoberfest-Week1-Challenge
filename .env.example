# Copy this file to .env for local development. Never commit .env.
PORT=3001

# Local Ollama (optional; server code reads these values only)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_HOSTED=gemma3:4b
EMBED_MODEL=embeddinggemma

# Optional integrations. Keep credentials in .env, not this template.
MONGODB_URI=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=
CDN_BASE_URL=
ADMIN_KEY=
ALLOWED_ORIGIN=
INAT_USER_AGENT=
WILDPACK_OUTPUT_DIR=generated-packs
