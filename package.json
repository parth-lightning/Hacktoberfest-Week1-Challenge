{
  "name": "sylva-landing-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
