    "typecheck": "tsc -b --pretty",
    "test:core": "tsx --test packages/core/test/geo.test.ts"
  },
  "dependencies": {
    "@designcodeio/threeui": "^1.2.0",
    "express": "^5.1.0",
    "react": "^18.3.1",
